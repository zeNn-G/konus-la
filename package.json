{
  "name": "konus-la",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "vitest": "^4.1.9",
      "@types/bun": "^1.3.4",
      "@orpc/server": "^1.14.6",
      "@orpc/zod": "^1.14.6",
      "@orpc/experimental-pino": "^1.14.6",
      "pino": "^9.13.1",
      "pino-pretty": "^13.1.1",
      "better-auth": "1.6.11",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@orpc/client": "^1.14.6",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @konus-la/db db:push",
    "db:studio": "turbo -F @konus-la/db db:studio",
    "db:generate": "turbo -F @konus-la/db db:generate",
    "db:migrate": "turbo -F @konus-la/db db:migrate",
    "db:local": "turbo -F @konus-la/db db:local",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@konus-la/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@konus-la/config": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "mediasoup"
  ]
}
